# Discord Bot Token aus dem Discord Developer Portal.
# Niemals den echten Token in GitHub hochladen.
BOT_TOKEN=

# Application ID vom Bot.
CLIENT_ID=

# Testserver ID fuer Slash Commands.
GUILD_ID=

# Optional: BotHosting.net Webhook fuer spaeteren Auto-Restart / Auto-Deploy.
BOT_HOSTING_WEBHOOK_URL=

# Optional: OpenAI-kompatibler HTTPS-Chat-Endpunkt. Nie in GitHub committen.
NOVORA_AI_ENDPOINT=
NOVORA_AI_API_KEY=
NOVORA_AI_MODEL=
